
<% layout("/layouts/boilerplate") %>

<div class="new-listing-container mt-4 mb-4">
    <h3>Create a new listing</h3>

    <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation new-listing-form"
        enctype="multipart/form-data"
    >
        <!-- Title -->
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input
                type="text"
                id="title"
                name="listing[title]"
                placeholder="Add a catchy title"
                class="form-control"
                required
            >
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Title needed.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea
                id="description"
                name="listing[description]"
                placeholder="Describe your property"
                class="form-control"
                required
            ></textarea>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Description needed.</div>
        </div>

        <!-- Image upload -->
        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input
                type="file"
                id="image"
                name="listing[image][url]"
                accept="image/png,image/jpeg,image/jpg"
                class="form-control"
            >
            <div class="form-text">
                Upload a JPG or PNG image of your property.
            </div>
        </div>

        <!-- Price and Country -->
        <div class="row">
            <div class="col-12 col-md-4 mb-3">
                <label for="price" class="form-label">Price per night (₹)</label>
                <input
                    type="number"
                    id="price"
                    name="listing[price]"
                    placeholder="1200"
                    min="0"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Enter a valid price.</div>
            </div>

            <div class="col-12 col-md-8 mb-3">
                <label for="country" class="form-label">Country</label>
                <input
                    type="text"
                    id="country"
                    name="listing[country]"
                    placeholder="India"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Country needed.</div>
            </div>
        </div>

        <!-- Location -->
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input
                type="text"
                id="location"
                name="listing[location]"
                placeholder="Jaipur, Rajasthan"
                class="form-control"
                required
            >
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Location needed.</div>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn btn-dark add-btn mb-3">
            Add Listing
        </button>
    </form>
</div>
