
<% layout("/layouts/boilerplate") %>

<!-- Listing Filters -->
<div id="filters">
    <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-tents"></i>
        <p>Camping</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-seedling"></i>
        <p>Farms</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-snowman"></i>
        <p>Arctic</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-landmark-dome"></i>
        <p>Domes</p>
    </div>

    <!-- Tax Toggle -->
    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="flexSwitchCheckDefault"
                aria-label="Display total price including taxes"
            >
            <label
                class="form-check-label"
                for="flexSwitchCheckDefault"
            >
                Display total after taxes
            </label>
        </div>
    </div>
</div>

<!-- Listings -->

<!-- Listings -->
<% if (allListings.length === 0) { %>

    <div class="text-center my-5">
        <h3>No listings found!</h3>

        <% if (search) { %>
            <p class="text-muted">
                Sorry, no listings exist for "<%= search %>".
                Try searching for another destination.
            </p>
        <% } else { %>
            <p class="text-muted">
                There are no listings available right now.
            </p>
        <% } %>

        <a href="/listings" class="btn btn-dark mt-2">
            Go to Homepage
        </a>
    </div>

<% } else { %>

    <div class="listings-row">
        <% for (let listing of allListings) { %>
            <a
                href="/listings/<%= listing._id %>"
                class="listing-link"
            >
                <div class="card listing-card">
                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                        loading="lazy"
                    >

                    <div class="card-img-overlay"></div>

                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br>

                            &#8377;<%= listing.price.toLocaleString("en-IN") %>
                            / night

                            <i class="tax-info">
                                &nbsp; +18% GST
                            </i>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>

<% } %>


<!-- Tax Toggle Functionality -->
<script>
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
    const taxInfoElements = document.querySelectorAll(".tax-info");

    taxSwitch.addEventListener("change", () => {
        for (const info of taxInfoElements) {
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }
            else{
                info.style.display = "none";
            }
        }
    });
</script>
